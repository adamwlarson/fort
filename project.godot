[application]
config/name="Fort"
config/version="24"
config/description="A four-player cooperative dwarf survival game"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[network]
limits/debugger/max_chars_per_second=32768

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
ability={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
repair={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
build_mode={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":66)]}
travel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":84)]}
cycle_weapon={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
cancel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
rotate_build={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
ready_night={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Interactables"
